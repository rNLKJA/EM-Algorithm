# Copy to .env.local for local overrides. Nothing here is secret; the site needs no keys.

# Canonical and Open Graph base URL (metadataBase in src/app/layout.tsx).
# Defaults to https://em-algorithm-lab.vercel.app when unset or blank.
NEXT_PUBLIC_SITE_URL=

# Git ref that the site's "view source" links point at (src/lib/site.ts).
# Defaults to main when unset or blank; a deployment can pin it to the commit it
# was built from, e.g. vercel deploy --build-env NEXT_PUBLIC_REPO_REF=<sha>.
NEXT_PUBLIC_REPO_REF=
